df\n    else:\n        print(f\"\\033[92m{col}: {len(bounded_df)} outliers with  spread ratio  {spread_ratio:,.3f}\\033[0m\")\n    return bounded_df\n\n# Call for each numeric column\n# Prepare data, drop NaNs for each feature\nfor col in df.select_dtypes(include=np.number).columns[2:]: # Ignore Id and MSSubClass\n    #Whiskers → Usually 1.5 × IQR beyond quartiles\n    outlier_indices = get_outliers(df, col,1.5,1)\n\nfeatures = list(outliers_dict.keys())\n# Extract the data for boxplots as a list of arrays\nviz = df[features]\nviz.hist(figsize=(24, 15), bins=30)\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-01-02T08:20:00.321278Z","iopub.execute_input":"2026-01-02T08:20:00.321628Z","iopub.status.idle":"2026-01-02T08:20:03.037907Z","shell.execute_reply.started":"2026-01-02T08:20:00.321593Z","shell.execute_reply":"2026-01-02T08:20:03.037030Z"}},"outputs":[{"name":"stdout","text":"\u001b[91mLotFrontage: 88 outliers with spread ratio 0.072 (313.00, 70.05)\u001b[0m\n\u001b[91mLotArea: 69 outliers with spread ratio 0.019 (215,245.00, 10,516.83)\u001b[0m\n\u001b[91mOverallQual: 2 outliers with spread ratio 0.222 (10.00, 6.10)\u001b[0m\n\u001b[91mOverallCond: 125 outliers with spread ratio 0.125 (9.00, 5.58)\u001b[0m\n\u001b[91mYearBuilt: 7 outliers with spread ratio 0.333 (2,010.00, 1,971.27)\u001b[0m\n\u001b[92mYearRemodAdd: 0 outliers with  spread ratio  0.617\u001b[0m\n\u001b[91mMasVnrArea: 96 outliers with spread ratio 0.104 (1,600.00, 103.69)\u001b[0m\n\u001b[91mBsmtFinSF1: 7 outliers with spread ratio 0.126 (5,644.00, 443.64)\u001b[0m\n\u001b[92mBsmtFinSF2: 167 outliers with  spread ratio  0.000\u001b[0m\n\u001b[91mBsmtUnfSF: 29 outliers with spread ratio 0.250 (2,336.00, 567.24)\u001b[0m\n\u001b[91mTotalBsmtSF: 61 outliers with spread ratio 0.082 (6,110.00, 1,057.43)\u001b[0m\n\u001b[91m1stFlrSF: 20 outliers with spread ratio 0.117 (4,692.00, 1,162.63)\u001b[0m\n\u001b[91m2ndFlrSF: 2 outliers with spread ratio 0.353 (2,065.00, 346.99